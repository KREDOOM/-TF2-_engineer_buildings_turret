"VertexLitGeneric"
{
	"$baseTexture" "models\weapons\v_pda_engineer/v_pda_engineer_screen"
	"$basemapalphaphongmask" "1"
	"$basealphaenvmapmask" "1"
//	"$bumpmap" "models/weapons\v_pda_engineer\v_pda_engineer_screen_normal"
//	"$translucent" 1
	"$envmap" "env_cubemap"
	"$envmaptint"	"[0.5 0.7 0.7]"
	"$envmaplightscale"	"1"

	"$phongdisablehalflambert" "1"
	"$phong"	"1"
	"$phongexponent" "25"
	"$phongboost" "5"	
	"$lightwarptexture" "models\lightwarps\weapon_lightwarp"
	"$phongfresnelranges"	"[.25 .5 1]"


	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$yellow" "0"

    "Proxies"
    {
        "ConVarEx"
        {
             "ConVar" "tf2c_player_nohalflambert"
              "0"
                {
                     "$PhongDisableHalfLambert"  "0"
                }
               "1"
               {
                   "$PhongDisableHalfLambert"  "1"
               }
        }
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}
